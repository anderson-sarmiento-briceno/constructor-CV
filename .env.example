# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# Clave de la API de Groq (https://console.groq.com/keys)
APY_KEY=

# Opcionales: descoméntalas solo si quieres cambiar los valores por defecto del código.
# GROQ_MODEL=
# GROQ_TIMEOUT=
# GROQ_REASONING_EFFORT=   (vacía = no enviar parámetros de razonamiento, para modelos que no razonan)
